            {
              "id": "srp-002",
              "severity": "SEVERE",
              "metric": "SRP-2",
              "line_start": 214,
              "line_end": 1288,
              "title": "View contains multiple disjoint responsibility groups",
              "issue": "LogViewerView has separate cohesion groups for screen/message rendering, PTY bridge input and prompts, navigation/file opening, and task progress display. Methods such as permissionPrompt(_:), askUserQuestionPrompt(_:toolID:), planApprovalPrompt(), inputField, and sendInput() operate on bridge/input prompt state, while taskPanelView/taskIcon/taskColor form a task-panel cluster and the message/tool renderers form another cluster.",
              "impact": "Independent changes to prompt interaction, task progress UX, navigation, or message/tool rendering all require edits to the same view type, making regressions more likely as the screen grows.",
              "rule_source": "SRP-2: 2+ cohesion groups is SEVERE."
            },
            {
              "id": "srp-003",
              "severity": "SEVERE",
              "metric": "SRP-1",
              "line_start": 214,
              "line_end": 1288,
              "title": "View performs many actions for multiple stakeholders",
              "issue": "The unit performs 16 distinct verbs, including resolving, checking, formatting, calculating, rendering, composing, orchestrating, mapping, dispatching, diffing, prompting, sending, and summarizing. These map to multiple stakeholders: visual/message presentation, interactive session workflow, navigation/file-opening UX, and task progress UX.",
              "impact": "The type has multiple independent reasons to change, so feature work in one workflow can affect unrelated rendering and interaction behavior.",
              "rule_source": "SRP-1: 3+ verbs with 2+ stakeholders is SEVERE."
            }
          ]
        },
