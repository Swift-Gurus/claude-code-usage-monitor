          "findings": [
            {
              "id": "srp-004",
              "severity": "SEVERE",
              "metric": "SRP-2",
              "line_start": 214,
              "line_end": 1282,
              "title": "LogViewerView contains 4 disjoint cohesion groups",
              "issue": "Excluding broadly-shared injected dependencies, the variable graph splits into independent groups: (1) screen-rendering (vm/settings + many render methods, color/icon mapping, dispatch), (2) text-input (inputText used only by inputField/sendInput), (3) ask-user-question selection state (selectedOptionIdx + promptToolID used only by askUserQuestionPrompt), (4) TTY command construction (permissionPrompt/planApprovalPrompt/askUserQuestionPrompt/sendInput emit raw escape sequences and \\r through bridge). No single bridge method touches all groups; selection state and input text are completely disjoint from rendering state.",
              "impact": "A 1072-line View struct concentrates UI rendering, layout, color/icon mapping, tool-kind dispatch, modal selection state, and TTY wire-protocol construction. Each concern can change independently, making this struct a magnet for unrelated edits and a serious maintainability liability.",
              "rule_source": "SRP-2 cohesion-group analysis (rule.md)"
            },
            {
              "id": "srp-005",
              "severity": "SEVERE",
              "metric": "SRP-3",
              "line_start": 952,
              "line_end": 1138,
              "title": "TTY wire-protocol construction lives inside the View",
              "issue": "permissionPrompt (lines 966-1029), askUserQuestionPrompt (lines 1031-1093), planApprovalPrompt (lines 1095-1138), and sendInput (lines 1183-1188) embed raw terminal escape sequences (\\u001b[B for arrow-down, \\r for Enter, \\u001b for Escape) directly inside SwiftUI button actions. The View now owns a TTY/Protocol stakeholder concern alongside its UX stakeholder concern.",
              "impact": "Two distinct stakeholders (UX designer, TTY/protocol engineer) can independently demand changes to the same struct. Changing terminal control sequences (e.g. switching to a different TUI input library, supporting alternate keymaps) requires editing a SwiftUI view; conversely changing visuals risks breaking input semantics.",
              "rule_source": "SRP-3 stakeholder gate (rule.md)"
            },
            {
              "id": "srp-006",
              "severity": "SEVERE",
              "metric": "SRP-1",
              "line_start": 619,
              "line_end": 706,
              "title": "toolExpandedContent fans out across 12+ tool kinds with mixed concerns",
              "issue": "toolExpandedContent dispatches 12 ToolData cases and inlines bespoke rendering for several (agent, taskCreate, askUserQuestion, webSearch, webFetch, exitPlanMode, other) while delegating to dedicated helpers for others. The struct also owns editDiffView/writeDiffView/mcpDetailView/hookDetailView/todoChecklist/permissionPrompt/askUserQuestionPrompt/planApprovalPrompt — each is a self-contained renderer for an unrelated tool family.",
              "impact": "Adding or changing the rendering of any single tool kind forces a change in this View. The View's verb count (9 distinct verbs across rendering/mapping/dispatching/sending/computing) far exceeds the COMPLIANT threshold and combines with multiple stakeholders to escalate severity.",
              "rule_source": "SRP-1 verb counting (rule.md)"
            }
          ]
        },
