            {
              "id": "srp-001",
              "severity": "SEVERE",
              "metric": "SRP-2",
              "line_start": 69,
              "line_end": 198,
              "title": "LogViewerViewModel has 3 disjoint cohesion groups",
              "issue": "The class splits into three disjoint variable sets: (a) {agent, target, urlResolver} used only by fileURL, (b) {modelResolver} used only by roleLabel, (c) {lastMtime, fileSystem, parser, messages, isLoading, displayedMessages, taskList, toolResultLookup, pendingPrompt} used by loadMessages/startPolling/rebuildDerivedState. No method bridges all three sets, so they are structurally independent responsibilities living in one type.",
              "impact": "Changes to URL resolution, model name formatting, and message loading/derivation each have an independent reason to modify the class. The view-model becomes a junction for unrelated concerns and is harder to test in isolation (each group requires unrelated mocks).",
              "rule_source": "SRP-2 cohesion-group analysis (rule.md)"
            },
            {
              "id": "srp-002",
              "severity": "SEVERE",
              "metric": "SRP-1",
              "line_start": 145,
              "line_end": 191,
              "title": "rebuildDerivedState performs four distinct derivations in one method",
              "issue": "rebuildDerivedState filters displayedMessages, reconstructs the task list from todoWrite/taskCreate/taskUpdate calls, builds toolResultLookup, and finds the pending prompt. Each derivation has its own input shape and output state field; they are mixed in a single 45-line loop.",
              "impact": "A change to task reconstruction (e.g. new TodoWrite schema) forces a re-read of unrelated prompt-detection logic; the four sub-responsibilities cannot evolve independently and each touches different output state.",
              "rule_source": "SRP-1 verb counting (rule.md)"
            },
            {
              "id": "srp-003",
              "severity": "SEVERE",
              "metric": "SRP-3",
              "line_start": 69,
              "line_end": 198,
              "title": "Three independent stakeholders can request changes",
              "issue": "Stakeholder cross-check: Infrastructure (URL/path layout via urlResolver), UX (display-name formatting via modelResolver), and Data/Domain (file polling, caching, derivation) each independently request modifications to this class.",
              "impact": "With 8 verbs across 3 stakeholders, the class triggers the SRP-1 SEVERE escalation (3+ verbs + 2+ stakeholders) on top of the structural SRP-2 finding.",
              "rule_source": "SRP-3 stakeholder gate (rule.md)"
            }
          ]
        },
